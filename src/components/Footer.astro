---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = 2026;
---
<footer class="ft">
  <div class="ft-lockup">
    <img src={base + '/small-sheep.png'} alt="" width="309" height="240" aria-hidden="true">
    <span>Blue Sheep</span>
  </div>
  <div class="ft-cols">
    <div>
      <p class="lbl">Studio</p>
      <p>12 Birch Ave.<br>Toronto, Ontario<br>Canada</p>
    </div>
    <div>
      <p class="lbl">Enquiries</p>
      <p><a href="mailto:info@bluesheepfilms.com">info@bluesheepfilms.com</a><br>Usually a reply within two days.</p>
    </div>
    <div>
      <p class="lbl">Elsewhere</p>
      <p><a href="https://vimeo.com/bluesheepfilms" target="_blank" rel="noopener noreferrer">Vimeo</a><br>
         <a href="https://www.instagram.com/bluesheep.films/" target="_blank" rel="noopener noreferrer">Instagram</a></p>
    </div>
    <div>
      <p class="lbl">Index</p>
      <p><a href={base + '/work.html'}>Work</a><br><a href={base + '/about.html'}>Studio</a><br><a href={base + '/contact.html'}>Contact</a></p>
    </div>
  </div>
  <div class="ft-base">
    <span class="lbl">&copy; {year} Blue Sheep</span>
    <span class="lbl">Founded 2023 &mdash; Toronto</span>
  </div>
</footer>
<style>
  .ft { border-top: 1px solid var(--rule); margin-top: var(--stack);
        max-width: var(--measure); margin-inline: auto; padding: clamp(34px,5vh,60px) var(--gutter) 40px; }
  .ft-lockup { display: flex; align-items: center; gap: clamp(12px, 2vw, 26px); margin-bottom: clamp(28px,4vh,46px); }
  .ft-lockup img { width: clamp(52px, 7vw, 96px); height: auto; }
  .ft-lockup span { font-family: var(--serif); font-variation-settings: var(--axes-display);
                    font-size: clamp(40px, 7.2vw, 104px); line-height: .9; letter-spacing: -.03em; }
  .ft-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(158px, 1fr)); gap: 26px clamp(18px,3vw,44px);
             padding-top: 22px; border-top: 1px solid var(--rule-hair); }
  .ft-cols p { font-size: var(--t-small); line-height: 1.62; color: var(--ink-soft); }
  .ft-cols .lbl { margin-bottom: 9px; }
  .ft-cols a { text-decoration: none; }
  .ft-cols a:hover { text-decoration: underline; }
  .ft-base { display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap;
             margin-top: clamp(30px,4vh,52px); padding-top: 15px; border-top: 1px solid var(--rule-hair); }
</style>
