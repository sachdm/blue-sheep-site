---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname;
const links = [
  { href: base + '/work.html', label: 'Work', mark: '01' },
  { href: base + '/about.html', label: 'Studio', mark: '02' },
  { href: base + '/contact.html', label: 'Contact', mark: '03' },
  { href: base + '/investors.html', label: 'Slate', mark: '04' },
];
---
<header class="hdr">
  <div class="hdr-rail">
    <span class="lbl">Blue Sheep Films &mdash; Toronto, Ontario</span>
    <span class="lbl lbl-blue hdr-rail-mid">A working index of everything we have finished</span>
    <a class="lbl hdr-rail-mail" href="mailto:info@bluesheepfilms.com">info@bluesheepfilms.com</a>
  </div>
  <nav class="hdr-bar" aria-label="Primary">
    <a class="hdr-brand" href={base + '/'}>
      <img src={base + '/small-sheep.png'} alt="" width="309" height="240" aria-hidden="true">
      <span>Blue Sheep</span>
    </a>
    <ul class="hdr-links">
      {links.map(l => (
        <li>
          <a href={l.href} aria-current={here.endsWith(l.href.split('/').pop()) ? 'page' : undefined}>
            <span class="hdr-mark">&sect;{l.mark}</span>{l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: var(--paper); border-bottom: 1px solid var(--rule); }
  .hdr-rail { display: flex; align-items: center; justify-content: space-between; gap: 16px;
              max-width: var(--measure); margin-inline: auto; padding: 9px var(--gutter);
              border-bottom: 1px solid var(--rule-hair); }
  .hdr-rail-mid { font-style: normal; }
  .hdr-rail-mail { text-decoration: none; }
  .hdr-rail-mail:hover { color: var(--blue); }
  .hdr-bar { display: flex; align-items: center; justify-content: space-between; gap: 20px;
             max-width: var(--measure); margin-inline: auto; padding: 11px var(--gutter); }
  .hdr-brand { display: flex; align-items: center; gap: 11px; text-decoration: none; color: var(--ink);
               font-family: var(--serif); font-variation-settings: var(--axes-head); font-size: 21px; }
  .hdr-brand img { width: 30px; height: auto; }
  .hdr-links { display: flex; gap: clamp(14px, 2.4vw, 34px); list-style: none; }
  .hdr-links a { font-family: var(--mono); font-size: var(--t-label); letter-spacing: .16em;
                 text-transform: uppercase; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .hdr-links a:hover, .hdr-links a[aria-current="page"] { color: var(--blue); }
  .hdr-mark { color: var(--blue); margin-right: 7px; }
  @media (max-width: 720px) {
    .hdr-rail-mid, .hdr-rail-mail { display: none; }
    .hdr-mark { display: none; }
    .hdr-links { gap: 15px; }
    .hdr-bar { padding-block: 9px; }
  }
</style>
