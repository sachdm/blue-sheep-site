---
import Base from '../layouts/Base.astro';
---
<Base title="Contact — Blue Sheep" description="Blue Sheep, Toronto. info@bluesheepfilms.com — open for 2026 and 2027 projects.">
<section class="wrap ct">
  <div class="ct-rail"><span class="lbl"><span class="lbl-blue">§ 03</span> &nbsp;— &nbsp;Contact</span><span class="lbl">Open for 2026 / 2027</span></div>
  <div class="ct-grid">
    <div>
      <h1 class="ct-h">Say <em>hello</em>.</h1>
      <p class="ct-b">Got a project brewing, or just want to talk shop? One of us reads everything that comes in.</p>
      <a class="ct-mail" href="mailto:info@bluesheepfilms.com">info@bluesheepfilms.com</a>
    </div>
    <aside class="ct-card">
      <div><span class="lbl">Studio</span><span>12 Birch Ave.<br>Toronto, Ontario<br>Canada</span></div>
      <div><span class="lbl">General</span><span><a href="mailto:info@bluesheepfilms.com">info@bluesheepfilms.com</a></span></div>
      <div><span class="lbl">Elsewhere</span><span><a href="https://vimeo.com/bluesheepfilms" target="_blank" rel="noopener noreferrer">Vimeo</a> / <a href="https://www.instagram.com/bluesheep.films/" target="_blank" rel="noopener noreferrer">Instagram</a></span></div>
      <div><span class="lbl">Reply time</span><span>Usually within two days.</span></div>
    </aside>
  </div>
</section>
</Base>
<style>
  .ct { padding-top: clamp(24px,4vh,46px); padding-bottom: var(--stack); }
  .ct-rail { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 10px; border-bottom: 2px solid var(--ink); }
  .ct-grid { display: grid; grid-template-columns: minmax(0,1.5fr) minmax(260px,1fr); gap: clamp(24px,4vw,72px);
             margin-top: clamp(28px,4.5vh,56px); align-items: start; }
  .ct-h { font-family: var(--serif); font-variation-settings: var(--axes-display);
          font-size: clamp(46px, 8.6vw, 136px); line-height: .92; letter-spacing: -.04em; }
  .ct-h em { font-style: italic; color: var(--blue); }
  .ct-b { margin: clamp(18px,3vh,30px) 0; max-width: 42ch; color: var(--ink-soft); }
  .ct-mail { display: inline-block; font-family: var(--serif); font-variation-settings: var(--axes-head);
             font-style: italic; font-size: clamp(22px,3.2vw,42px); letter-spacing: -.02em; color: var(--ink);
             text-decoration: none; border-bottom: 3px solid var(--blue); padding-bottom: 5px; }
  .ct-mail:hover { color: var(--blue); }
  .ct-card { border: 1px solid var(--rule); }
  .ct-card > div { display: grid; grid-template-columns: 9ch 1fr; gap: 14px; padding: 15px 18px; border-bottom: 1px solid var(--rule-hair); }
  .ct-card > div:last-child { border-bottom: 0; }
  .ct-card span:last-child { font-size: var(--t-small); line-height: 1.6; }
  @media (max-width: 900px) { .ct-grid { grid-template-columns: 1fr; } }
</style>
