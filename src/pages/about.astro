---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Studio — Blue Sheep" description="Blue Sheep is a production company in Toronto. Development, production and post for independent shorts, commissioned work and music films.">
<section class="wrap ab">
  <div class="ab-rail"><span class="lbl"><span class="lbl-blue">§ 02</span> &nbsp;— &nbsp;The studio</span><span class="lbl">Founded 2023 · Toronto</span></div>
  <h1 class="ab-h">We make films the <em>slow</em> way.</h1>
  <div class="ab-cols">
    <div class="ab-c">
      <p class="lbl">Who we are</p>
      <p class="drop">Blue Sheep is a production company in Toronto, founded in 2023. A small crew who believe the best stories are found, not forced — shot on real locations, with real people, at the pace the story actually needs.</p>
      <p>We have kept the team small on purpose. Every project gets the same attention, whether it is a ninety-second spot or a feature doc, and everything is cut in the same room by the people who shot it.</p>
    </div>
    <div class="ab-c">
      <p class="lbl">What we do</p>
      <dl class="ab-list">
        <div><dt>Development</dt><dd>Scripts, coverage, beat sheets, financing plans and grant packages.</dd></div>
        <div><dt>Production</dt><dd>Small units on real locations. Narrative shorts, commercial and music film.</dd></div>
        <div><dt>Post</dt><dd>Edit, colour, sound and delivery — through to festival and distribution.</dd></div>
      </dl>
    </div>
    <aside class="ab-c ab-side">
      <p class="lbl">At a glance</p>
      <div class="ab-figs">
        <div><b>8</b><span class="lbl">Films finished</span></div>
        <div><b>2023</b><span class="lbl">Founded</span></div>
        <div><b>3</b><span class="lbl">In development</span></div>
        <div><b>TOR</b><span class="lbl">Home base</span></div>
      </div>
      <p class="ab-cta"><a class="lbl" href={base + '/work.html'}>See the index &rarr;</a></p>
    </aside>
  </div>
</section>
<section class="payoff"><div class="payoff-in wrap">
  <p class="lbl payoff-lbl">The standard, stated plainly</p>
  <p class="payoff-line">Nothing leaves that we <em>would not sit through twice.</em></p>
</div></section>
</Base>
<style>
  .ab { padding-top: clamp(24px,4vh,46px); }
  .ab-rail { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 10px; border-bottom: 2px solid var(--ink); }
  .ab-h { font-family: var(--serif); font-variation-settings: var(--axes-display);
          font-size: clamp(42px, 8vw, 124px); line-height: .93; letter-spacing: -.04em;
          margin: clamp(20px,3vh,36px) 0 clamp(28px,4vh,52px); max-width: 14ch; }
  .ab-h em { font-style: italic; color: var(--blue); }
  .ab-cols { display: grid; grid-template-columns: minmax(0,1.25fr) minmax(0,1fr) minmax(190px,.78fr);
             gap: clamp(20px,3vw,46px); padding-top: 22px; border-top: 1px solid var(--rule); }
  .ab-c > .lbl { margin-bottom: 12px; }
  .ab-c p { margin-bottom: 12px; color: var(--ink-soft); }
  .drop::first-letter { float: left; font-size: 3.4em; line-height: .8; padding: 4px 8px 0 0; font-variation-settings: var(--axes-display); color: var(--ink); }
  .ab-list div { padding: 12px 0; border-bottom: 1px solid var(--rule-hair); }
  .ab-list dt { font-family: var(--serif); font-variation-settings: var(--axes-head); font-size: 21px; letter-spacing: -.015em; }
  .ab-list dd { font-size: var(--t-small); color: var(--ink-soft); margin-top: 4px; }
  .ab-side { border-left: 1px solid var(--rule-hair); padding-left: clamp(14px,2vw,26px); }
  .ab-figs { display: grid; gap: 16px; }
  .ab-figs b { display: block; font-family: var(--serif); font-variation-settings: var(--axes-display);
               font-size: clamp(32px,3.6vw,52px); line-height: .9; letter-spacing: -.03em; font-weight: 420; }
  .ab-cta { margin-top: 20px; }
  .ab-cta a { text-decoration: none; }
  .ab-cta a:hover { color: var(--blue); }
  .payoff { background: var(--blue); color: #fff; margin-top: var(--stack); padding: clamp(64px,13vh,160px) 0; }
  .payoff-lbl { color: rgba(255,255,255,.72) !important; margin-bottom: clamp(14px,3vh,30px); }
  .payoff-line { font-family: var(--serif); font-variation-settings: var(--axes-display);
                 font-size: clamp(34px, 6.6vw, 104px); line-height: .96; letter-spacing: -.035em; max-width: 17ch; }
  .payoff-line em { font-style: italic; }
  @media (max-width: 1000px) { .ab-cols { grid-template-columns: 1fr; } .ab-side { border-left: 0; border-top: 1px solid var(--rule-hair); padding-left: 0; padding-top: 18px; } }
</style>
