---
import Base from '../layouts/Base.astro';
import films from '../data/films.json';
export function getStaticPaths() {
  return films.map((f, i) => ({
    params: { slug: f.slug },
    props: { film: f, i, next: films[(i + 1) % films.length] },
  }));
}
const { film, i, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = film.vimeoId
  ? `https://player.vimeo.com/video/${film.vimeoId}${film.vimeoHash ? '?h=' + film.vimeoHash + '&' : '?'}dnt=1&title=0&byline=0&portrait=0`
  : null;
---
<Base title={`${film.title} — Blue Sheep`} description={`${film.title} — ${film.cat}, ${film.year}. ${film.standfirst}`} image={film.still}>
<article class="wrap pg">
  <div class="pg-rail">
    <span class="lbl"><span class="lbl-blue">Entry {String(i + 1).padStart(2, '0')}</span> &nbsp;— &nbsp;{film.cat}</span>
    <span class="lbl">{film.year}</span>
  </div>

  <h1 class="pg-title">{film.title}</h1>
  <p class="pg-stand">{film.standfirst}</p>

  <div class="plate pg-plate">
    {src ? <iframe src={src} title={`${film.title} — film player`} allow="fullscreen; picture-in-picture" loading="lazy"></iframe>
         : film.still && <img src={film.still} alt={`Still from ${film.title}`}>}
  </div>
  <div class="plate-cap"><span class="lbl">Fig. 1 — {film.title}</span><span class="lbl">{film.cat} · {film.year}</span></div>

  <div class="pg-grid">
    <div class="pg-note">
      <p class="lbl">The note</p>
      <p class="pg-note-body">{film.note}</p>
      <p class="pg-pull">{film.pull}</p>
    </div>
    <aside class="pg-side">
      <p class="lbl">Credits</p>
      {film.credits.map(c => (
        <div class="pg-cred"><span class="lbl">{c.role}</span><span>{c.name}</span></div>
      ))}
      <p class="lbl pg-keys-h">Keys</p>
      <p class="pg-keys">{film.keys.join(' · ')}</p>
    </aside>
  </div>

  <nav class="pg-nav" aria-label="Between entries">
    <a class="lbl" href={base + '/work.html'}>&larr; All entries</a>
    <a class="lbl" href={`${base}/${next.slug}.html`}>Next: {next.title} &rarr;</a>
  </nav>
</article>
</Base>
<style>
  .pg { padding-top: clamp(24px, 4vh, 46px); }
  .pg-rail { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 10px; border-bottom: 2px solid var(--ink); }
  .pg-title { font-family: var(--serif); font-variation-settings: var(--axes-display);
              font-size: clamp(36px, 6.4vw, 96px); line-height: .96; letter-spacing: -.035em;
              margin: clamp(20px,3vh,36px) 0 12px; max-width: 18ch; }
  .pg-stand { font-style: italic; font-size: clamp(17px, 1.8vw, 23px); color: var(--ink-soft);
              max-width: 46ch; margin-bottom: clamp(22px,3.4vh,40px); }
  .pg-plate { aspect-ratio: 16 / 9; }
  .pg-plate iframe { width: 100%; height: 100%; border: 0; }
  .pg-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(200px, .8fr);
             gap: clamp(20px, 3vw, 52px); margin-top: clamp(28px,4vh,50px); }
  .pg-note .lbl { margin-bottom: 12px; }
  .pg-note-body { font-size: clamp(17px, 1.7vw, 21px); line-height: 1.55; max-width: 58ch; }
  .pg-pull { font-family: var(--serif); font-variation-settings: var(--axes-display); font-style: italic;
             font-size: clamp(24px, 3.2vw, 44px); line-height: 1.08; letter-spacing: -.02em; color: var(--blue);
             margin-top: clamp(20px,3vh,34px); max-width: 20ch; }
  .pg-side { border-left: 1px solid var(--rule-hair); padding-left: clamp(14px,2vw,26px); }
  .pg-cred { display: flex; flex-direction: column; gap: 2px; margin-bottom: 12px; }
  .pg-cred span:last-child { font-size: var(--t-small); }
  .pg-keys-h { margin-top: 20px; }
  .pg-keys { font-size: var(--t-small); color: var(--ink-soft); margin-top: 7px; }
  .pg-nav { display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap;
            margin-top: var(--stack); padding-top: 14px; border-top: 2px solid var(--ink); }
  .pg-nav a { text-decoration: none; color: var(--ink); }
  .pg-nav a:hover { color: var(--blue); }
  @media (max-width: 900px) {
    .pg-grid { grid-template-columns: 1fr; }
    .pg-side { border-left: 0; border-top: 1px solid var(--rule-hair); padding-left: 0; padding-top: 18px; }
  }
</style>
